# Copy this file to .env and fill in your values

# Anthropic API Key (required for AI Agent nodes)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Database Configuration
# Choose either "postgres" or "sqlite"
DB_DRIVER=postgres

# PostgreSQL Configuration (when DB_DRIVER=postgres)
DB_HOST=postgres
DB_PORT=5432
DB_USER=workflow
DB_PASSWORD=workflow_password
DB_NAME=workflows
DB_SSLMODE=disable

# SQLite Configuration (when DB_DRIVER=sqlite)
# DATABASE_PATH=./data/workflows.db
