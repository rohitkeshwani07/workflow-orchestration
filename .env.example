# Copy this file to .env and fill in your values

# ============================================
# AI Provider API Keys
# ============================================
# Anthropic API Key (required for AI Agent nodes and AI Agent Service)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key (optional, for AI Agent Service with OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# Security
# ============================================
# Encryption key for credential storage (base64 encoded 32-byte key)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your_base64_encoded_32_byte_key_here

# ============================================
# Database Configuration
# ============================================
# Choose either "postgres" or "sqlite"
DB_DRIVER=postgres

# PostgreSQL Configuration (when DB_DRIVER=postgres)
DB_HOST=postgres
DB_PORT=5432
DB_USER=workflow
DB_PASSWORD=workflow_password
DB_NAME=workflows
DB_SSLMODE=disable

# SQLite Configuration (when DB_DRIVER=sqlite)
# DATABASE_PATH=./data/workflows.db

# ============================================
# AI Agent Service Configuration
# ============================================
# Default provider for AI agents (anthropic or openai)
AI_DEFAULT_PROVIDER=anthropic

# Default model for AI agents
AI_DEFAULT_MODEL=claude-3-5-sonnet-20241022

# MCP Servers (comma-separated list, format: name:command:args)
# Example: AI_MCP_SERVERS=filesystem:/usr/local/bin/mcp-server-filesystem:--root /data
AI_MCP_SERVERS=
